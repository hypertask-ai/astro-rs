{
  "name": "rat-stack",
  "version": "0.1.0",
  "private": true,
  "description": "hypertask.ai site scaffold on Rat Stack. Visitors still use the old site.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @rat-stack/web dev",
    "acceptance:cold-clone": "bash scripts/acceptance-cold-clone.sh",
    "alchemy": "pnpm --filter @rat-stack/infra exec alchemy",
    "build": "turbo run build",
    "bump:checkers": "node scripts/bump-checkers.ts",
    "check": "pnpm run lockfile:check && varlock load && turbo run typecheck typecheck-scripts && ultracite check && oxfmt --check .",
    "env:check": "varlock load",
    "fix": "ultracite fix && oxfmt .",
    "lint": "ultracite check && oxfmt --check .",
    "lockfile:check": "pnpm --config.optimistic-repeat-install=false install --frozen-lockfile --offline --lockfile-only --ignore-scripts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "infra:deploy": "pnpm --filter @rat-stack/infra deploy",
    "infra:destroy": "pnpm --filter @rat-stack/infra destroy",
    "infra:dev": "pnpm --filter @rat-stack/infra dev",
    "infra:plan": "pnpm --filter @rat-stack/infra plan",
    "prepare": "effect-tsgo patch && if git rev-parse --git-dir >/dev/null 2>&1; then lefthook install; fi",
    "sources:fetch": "echo 'No pinned content sources. This site does not vendor teaching excerpts.'",
    "test": "pnpm test:security-audit && turbo run test",
    "test:security-audit": "node --test skills/security-audit/*.test.cjs",
    "typecheck": "turbo run typecheck typecheck-scripts",
    "typecheck:tsc": "turbo run typecheck:tsc typecheck:tsc-scripts",
    "typecheck:tsc-scripts": "tsc --noEmit -p tsconfig.json",
    "typecheck:fast": "turbo run typecheck:fast typecheck:fast-scripts",
    "typecheck:fast-scripts": "tsrs --noEmit -p tsconfig.json",
    "typecheck:parity": "pnpm --filter @rat-stack/core typecheck:parity",
    "typecheck-scripts": "effect-tsrs diagnostics --project tsconfig.json --strict --type-check",
    "vendor:agent-sources": "./scripts/vendor-agent-sources.sh",
    "find-peers": "node scripts/find-peers.ts"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@effect/tsgo": "0.67.5",
    "@foldkit/oxlint-plugin": "0.15.4",
    "@oxlint/plugins": "1.92.0",
    "@types/node": "24.19.2",
    "@types/pngjs": "6.0.5",
    "@yielded/effect-tsrs": "0.2.3",
    "effect": "4.1.2",
    "lefthook": "2.2.2",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "playwright": "1.65.1",
    "pngjs": "7.0.0",
    "portless": "0.16.0",
    "tsrs": "0.23.0-ts7.1.0-beta",
    "turbo": "2.11.10",
    "typescript": "7.0.2",
    "ultracite": "8.1.1",
    "varlock": "1.24.0",
    "vitest": "5.1.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.3.0",
      "onFail": "warn"
    },
    "runtime": {
      "name": "node",
      "version": ">=24.18.0",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": ">=24.18.0",
    "pnpm": ">=11.1.2"
  },
  "packageManager": "pnpm@11.3.0"
}
