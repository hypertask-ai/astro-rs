{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["tsconfig.base.json"],
  "remoteCache": { "signature": true },
  "tasks": {
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "typecheck:tsc": {
      "dependsOn": ["^typecheck:tsc"],
      "outputs": []
    },
    "//#typecheck:tsc-scripts": {
      "outputs": []
    },
    "@hypertask-site/web#typecheck:tsc": {
      "dependsOn": ["^build", "^typecheck:tsc"],
      "outputs": []
    },
    "typecheck:fast": {
      "dependsOn": ["^typecheck:fast"],
      "outputs": []
    },
    "//#typecheck:fast-scripts": {
      "outputs": []
    },
    "@hypertask-site/web#typecheck:fast": {
      "dependsOn": ["^build", "^typecheck:fast"],
      "outputs": []
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "//#lint": {
      "outputs": []
    },
    "//#typecheck-scripts": {
      "outputs": []
    },
    "//#lockfile:check": {
      "cache": false,
      "outputs": []
    },
    "check": {
      "dependsOn": [
        "//#lockfile:check",
        "typecheck",
        "//#lint",
        "//#typecheck-scripts"
      ],
      "outputs": []
    },
    "@hypertask-site/web#typecheck": {
      "dependsOn": ["^build", "^typecheck"],
      "outputs": []
    },
    "@hypertask-site/infra#test": {
      "dependsOn": [
        "^build",
        "@hypertask-site/web#build",
        "@hypertask-site/web#test"
      ],
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/apps/web/src/**"]
    }
  }
}
