{
  "name": "@rat-stack/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "portless rat-stack vite dev",
    "typecheck": "effect-tsrs diagnostics --project tsconfig.json --strict --type-check",
    "typecheck:tsc": "tsc --noEmit -p tsconfig.json",
    "typecheck:fast": "tsrs --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "vite build",
    "check": "pnpm run typecheck"
  },
  "dependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.85",
    "@stylexjs/stylex": "0.19.1",
    "alchemy": "2.0.0-beta.85",
    "effect": "4.1.2",
    "foldkit": "0.170.0"
  },
  "devDependencies": {
    "@effect/vitest": "4.1.2",
    "@foldkit/vite-plugin": "0.29.0",
    "@stylexjs/unplugin": "0.19.1",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
