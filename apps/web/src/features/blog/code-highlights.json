{
  "ai-agent-task-management/0": "<span class=\"line\"><span style=\"color:#B392F0\">hypertask</span><span style=\"color:#9ECBFF\"> inbox</span><span style=\"color:#9ECBFF\"> list</span><span style=\"color:#79B8FF\"> --json</span></span>\n<span class=\"line\"><span style=\"color:#B392F0\">hypertask</span><span style=\"color:#9ECBFF\"> task</span><span style=\"color:#9ECBFF\"> get</span><span style=\"color:#9ECBFF\"> YPER-123</span><span style=\"color:#79B8FF\"> --json</span></span>\n<span class=\"line\"><span style=\"color:#B392F0\">hypertask</span><span style=\"color:#9ECBFF\"> task</span><span style=\"color:#9ECBFF\"> move</span><span style=\"color:#9ECBFF\"> YPER-123</span><span style=\"color:#79B8FF\"> --section</span><span style=\"color:#9ECBFF\"> &quot;Doing&quot;</span></span>\n<span class=\"line\"><span style=\"color:#B392F0\">hypertask</span><span style=\"color:#9ECBFF\"> comment</span><span style=\"color:#9ECBFF\"> add</span><span style=\"color:#9ECBFF\"> YPER-123</span><span style=\"color:#79B8FF\"> --text</span><span style=\"color:#9ECBFF\"> &quot;&lt;p&gt;Claimed. I am checking the build failure and will report back with the failing step, fix, and validation result.&lt;/p&gt;&quot;</span></span>",
  "ai-agent-task-management/1": "<span class=\"line\"><span style=\"color:#E1E4E8\">&lt;</span><span style=\"color:#85E89D\">p</span><span style=\"color:#E1E4E8\">&gt;&lt;</span><span style=\"color:#85E89D\">b</span><span style=\"color:#E1E4E8\">&gt;Progress:&lt;/</span><span style=\"color:#85E89D\">b</span><span style=\"color:#E1E4E8\">&gt; reproduced the failing checkout state locally. The regression appears to come from the discount-code validation path, not payment creation. Next I am adding a test around the invalid-code branch.&lt;/</span><span style=\"color:#85E89D\">p</span><span style=\"color:#E1E4E8\">&gt;</span></span>",
  "ai-agent-task-management/2": "<span class=\"line\"><span style=\"color:#E1E4E8\">&lt;</span><span style=\"color:#85E89D\">p</span><span style=\"color:#E1E4E8\">&gt;&lt;</span><span style=\"color:#85E89D\">b</span><span style=\"color:#E1E4E8\">&gt;Blocked:&lt;/</span><span style=\"color:#85E89D\">b</span><span style=\"color:#E1E4E8\">&gt; the task asks me to update production pricing copy, but the latest approved pricing source is unclear. Please confirm whether the source of truth is the pricing page or the sales deck.&lt;/</span><span style=\"color:#85E89D\">p</span><span style=\"color:#E1E4E8\">&gt;</span></span>",
  "ai-agent-task-management/3": "<span class=\"line\"><span style=\"color:#E1E4E8\">&lt;</span><span style=\"color:#85E89D\">p</span><span style=\"color:#E1E4E8\">&gt;&lt;</span><span style=\"color:#85E89D\">b</span><span style=\"color:#E1E4E8\">&gt;Done:&lt;/</span><span style=\"color:#85E89D\">b</span><span style=\"color:#E1E4E8\">&gt; fixed the checkout error by handling invalid discount-code responses before payment creation.&lt;/</span><span style=\"color:#85E89D\">p</span><span style=\"color:#E1E4E8\">&gt;</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">&lt;</span><span style=\"color:#85E89D\">ul</span><span style=\"color:#E1E4E8\">&gt;</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">  &lt;</span><span style=\"color:#85E89D\">li</span><span style=\"color:#E1E4E8\">&gt;Changed: &lt;</span><span style=\"color:#85E89D\">code</span><span style=\"color:#E1E4E8\">&gt;src/lib/checkout.ts&lt;/</span><span style=\"color:#85E89D\">code</span><span style=\"color:#E1E4E8\">&gt; and &lt;</span><span style=\"color:#85E89D\">code</span><span style=\"color:#E1E4E8\">&gt;src/routes/checkout.test.ts&lt;/</span><span style=\"color:#85E89D\">code</span><span style=\"color:#E1E4E8\">&gt;&lt;/</span><span style=\"color:#85E89D\">li</span><span style=\"color:#E1E4E8\">&gt;</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">  &lt;</span><span style=\"color:#85E89D\">li</span><span style=\"color:#E1E4E8\">&gt;Validation: &lt;</span><span style=\"color:#85E89D\">code</span><span style=\"color:#E1E4E8\">&gt;npm test -- checkout&lt;/</span><span style=\"color:#85E89D\">code</span><span style=\"color:#E1E4E8\">&gt; passed locally&lt;/</span><span style=\"color:#85E89D\">li</span><span style=\"color:#E1E4E8\">&gt;</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">  &lt;</span><span style=\"color:#85E89D\">li</span><span style=\"color:#E1E4E8\">&gt;Review: please check the copy on the invalid-code message before release&lt;/</span><span style=\"color:#85E89D\">li</span><span style=\"color:#E1E4E8\">&gt;</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">&lt;/</span><span style=\"color:#85E89D\">ul</span><span style=\"color:#E1E4E8\">&gt;</span></span>",
  "ai-agent-task-management/4": "<span class=\"line\"><span style=\"color:#E1E4E8\">&lt;</span><span style=\"color:#85E89D\">p</span><span style=\"color:#E1E4E8\">&gt;&lt;</span><span style=\"color:#85E89D\">b</span><span style=\"color:#E1E4E8\">&gt;Ready for review:&lt;/</span><span style=\"color:#85E89D\">b</span><span style=\"color:#E1E4E8\">&gt; drafted the Motion alternative article at &lt;</span><span style=\"color:#85E89D\">code</span><span style=\"color:#E1E4E8\">&gt;/blog/motion-alternative/&lt;/</span><span style=\"color:#85E89D\">code</span><span style=\"color:#E1E4E8\">&gt;.&lt;/</span><span style=\"color:#85E89D\">p</span><span style=\"color:#E1E4E8\">&gt;</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">&lt;</span><span style=\"color:#85E89D\">ul</span><span style=\"color:#E1E4E8\">&gt;</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">  &lt;</span><span style=\"color:#85E89D\">li</span><span style=\"color:#E1E4E8\">&gt;Included a comparison table, FAQ section, and internal links to the AI-agents pillar&lt;/</span><span style=\"color:#85E89D\">li</span><span style=\"color:#E1E4E8\">&gt;</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">  &lt;</span><span style=\"color:#85E89D\">li</span><span style=\"color:#E1E4E8\">&gt;Build: &lt;</span><span style=\"color:#85E89D\">code</span><span style=\"color:#E1E4E8\">&gt;npm run build&lt;/</span><span style=\"color:#85E89D\">code</span><span style=\"color:#E1E4E8\">&gt; passed&lt;/</span><span style=\"color:#85E89D\">li</span><span style=\"color:#E1E4E8\">&gt;</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">  &lt;</span><span style=\"color:#85E89D\">li</span><span style=\"color:#E1E4E8\">&gt;Review: check competitor positioning and title before merge&lt;/</span><span style=\"color:#85E89D\">li</span><span style=\"color:#E1E4E8\">&gt;</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">&lt;/</span><span style=\"color:#85E89D\">ul</span><span style=\"color:#E1E4E8\">&gt;</span></span>",
  "ai-agent-task-management/5": "<span class=\"line\"><span>At the start of each session, check your Hypertask inbox.</span></span>\n<span class=\"line\"><span>Pick one assigned task that is ready to work.</span></span>\n<span class=\"line\"><span>Before starting, move it to Doing and post a short claim comment.</span></span>\n<span class=\"line\"><span>Do the work using the task description and linked context.</span></span>\n<span class=\"line\"><span>If blocked, post a blocker comment with the exact decision needed.</span></span>\n<span class=\"line\"><span>When finished, post a final report with changed files or artifacts, validation, risks, and review request.</span></span>\n<span class=\"line\"><span>Move the task to Review unless the task explicitly says you may close it.</span></span>\n<span class=\"line\"><span>Do not work from a pasted task list when live board access is available.</span></span>",
  "ai-agents-project-management-guide/0": "<span class=\"line\"><span style=\"color:#6A737D\"># Pick up the highest-priority task</span></span>\n<span class=\"line\"><span style=\"color:#B392F0\">hypertask</span><span style=\"color:#9ECBFF\"> inbox</span><span style=\"color:#9ECBFF\"> list</span></span>\n<span class=\"line\"><span style=\"color:#B392F0\">hypertask</span><span style=\"color:#9ECBFF\"> task</span><span style=\"color:#9ECBFF\"> get</span><span style=\"color:#9ECBFF\"> HTPR-2992</span></span>\n<span class=\"line\"><span style=\"color:#B392F0\">hypertask</span><span style=\"color:#9ECBFF\"> task</span><span style=\"color:#9ECBFF\"> move</span><span style=\"color:#9ECBFF\"> HTPR-2992</span><span style=\"color:#79B8FF\"> --section</span><span style=\"color:#9ECBFF\"> &quot;Doing&quot;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D\"># Post a progress update</span></span>\n<span class=\"line\"><span style=\"color:#B392F0\">hypertask</span><span style=\"color:#9ECBFF\"> comment</span><span style=\"color:#9ECBFF\"> add</span><span style=\"color:#9ECBFF\"> HTPR-2992</span><span style=\"color:#79B8FF\"> --text</span><span style=\"color:#9ECBFF\"> &quot;&lt;p&gt;Deployed to production. Tests pass.&lt;/p&gt;&quot;</span></span>\n<span class=\"line\"><span style=\"color:#B392F0\">hypertask</span><span style=\"color:#9ECBFF\"> task</span><span style=\"color:#9ECBFF\"> move</span><span style=\"color:#9ECBFF\"> HTPR-2992</span><span style=\"color:#79B8FF\"> --section</span><span style=\"color:#9ECBFF\"> &quot;Done&quot;</span></span>",
  "ai-agents-project-management-guide/1": "<span class=\"line\"><span style=\"color:#B392F0\">npm</span><span style=\"color:#9ECBFF\"> install</span><span style=\"color:#79B8FF\"> -g</span><span style=\"color:#9ECBFF\"> @hypertask/hypertask_cli</span></span>\n<span class=\"line\"><span style=\"color:#B392F0\">hypertask</span><span style=\"color:#9ECBFF\"> auth</span><span style=\"color:#9ECBFF\"> login</span></span>",
  "best-ai-kanban-tool/0": "<span class=\"line\"><span style=\"color:#E1E4E8\">{</span></span>\n<span class=\"line\"><span style=\"color:#79B8FF\">  &quot;mcpServers&quot;</span><span style=\"color:#E1E4E8\">: {</span></span>\n<span class=\"line\"><span style=\"color:#79B8FF\">    &quot;hypertasks&quot;</span><span style=\"color:#E1E4E8\">: {</span></span>\n<span class=\"line\"><span style=\"color:#79B8FF\">      &quot;type&quot;</span><span style=\"color:#E1E4E8\">: </span><span style=\"color:#9ECBFF\">&quot;http&quot;</span><span style=\"color:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#79B8FF\">      &quot;url&quot;</span><span style=\"color:#E1E4E8\">: </span><span style=\"color:#9ECBFF\">&quot;https://mcp.hypertask.ai/mcp&quot;</span><span style=\"color:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#79B8FF\">      &quot;headers&quot;</span><span style=\"color:#E1E4E8\">: {</span></span>\n<span class=\"line\"><span style=\"color:#79B8FF\">        &quot;Authorization&quot;</span><span style=\"color:#E1E4E8\">: </span><span style=\"color:#9ECBFF\">&quot;Bearer YOUR_API_KEY&quot;</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">      }</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">}</span></span>",
