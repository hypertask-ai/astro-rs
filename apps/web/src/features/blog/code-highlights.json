  "best-kanban-tool-for-mcp/0": "<span class=\"line\"><span style=\"color:#E1E4E8\">{</span></span>\n<span class=\"line\"><span style=\"color:#79B8FF\">  &quot;mcpServers&quot;</span><span style=\"color:#E1E4E8\">: {</span></span>\n<span class=\"line\"><span style=\"color:#79B8FF\">    &quot;hypertasks&quot;</span><span style=\"color:#E1E4E8\">: {</span></span>\n<span class=\"line\"><span style=\"color:#79B8FF\">      &quot;type&quot;</span><span style=\"color:#E1E4E8\">: </span><span style=\"color:#9ECBFF\">&quot;http&quot;</span><span style=\"color:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#79B8FF\">      &quot;url&quot;</span><span style=\"color:#E1E4E8\">: </span><span style=\"color:#9ECBFF\">&quot;https://mcp.hypertask.ai/mcp&quot;</span><span style=\"color:#E1E4E8\">,</span></span>\n<span class=\"line\"><span style=\"color:#79B8FF\">      &quot;headers&quot;</span><span style=\"color:#E1E4E8\">: {</span></span>\n<span class=\"line\"><span style=\"color:#79B8FF\">        &quot;Authorization&quot;</span><span style=\"color:#E1E4E8\">: </span><span style=\"color:#9ECBFF\">&quot;Bearer YOUR_API_KEY&quot;</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">      }</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">    }</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">  }</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">}</span></span>",
  "best-kanban-tool-with-api/0": "<span class=\"line\"><span style=\"color:#F97583\">export</span><span style=\"color:#E1E4E8\"> HT_API_KEY</span><span style=\"color:#F97583\">=</span><span style=\"color:#9ECBFF\">&#39;YOUR_REST_API_KEY&#39;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#B392F0\">curl</span><span style=\"color:#79B8FF\"> --fail-with-body</span><span style=\"color:#79B8FF\"> --silent</span><span style=\"color:#79B8FF\"> --show-error</span><span style=\"color:#79B8FF\"> \\</span></span>\n<span class=\"line\"><span style=\"color:#79B8FF\">  -H</span><span style=\"color:#9ECBFF\"> &quot;Authorization: Bearer </span><span style=\"color:#E1E4E8\">$HT_API_KEY</span><span style=\"color:#9ECBFF\">&quot;</span><span style=\"color:#79B8FF\"> \\</span></span>\n<span class=\"line\"><span style=\"color:#9ECBFF\">  &#39;https://app.hypertask.ai/api/v1/user/context&#39;</span></span>",
  "best-kanban-tool-with-api/1": "<span class=\"line\"><span style=\"color:#B392F0\">npm</span><span style=\"color:#9ECBFF\"> install</span><span style=\"color:#79B8FF\"> -g</span><span style=\"color:#9ECBFF\"> @hypertask/hypertask_cli@latest</span></span>\n<span class=\"line\"><span style=\"color:#B392F0\">hypertask</span><span style=\"color:#9ECBFF\"> login</span></span>",
  "best-kanban-tool-with-api/2": "<span class=\"line\"><span style=\"color:#E1E4E8\">PROJECT_ID</span><span style=\"color:#F97583\">=</span><span style=\"color:#9ECBFF\">123</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">TICKET</span><span style=\"color:#F97583\">=</span><span style=\"color:#9ECBFF\">&#39;TEAM-42&#39;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#B392F0\">hypertask</span><span style=\"color:#9ECBFF\"> tasks</span><span style=\"color:#9ECBFF\"> list</span><span style=\"color:#79B8FF\"> --project</span><span style=\"color:#9ECBFF\"> &quot;</span><span style=\"color:#E1E4E8\">$PROJECT_ID</span><span style=\"color:#9ECBFF\">&quot;</span><span style=\"color:#79B8FF\"> \\</span></span>\n<span class=\"line\"><span style=\"color:#79B8FF\">  --fields</span><span style=\"color:#9ECBFF\"> title,url</span><span style=\"color:#79B8FF\"> --limit</span><span style=\"color:#79B8FF\"> 20</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#B392F0\">hypertask</span><span style=\"color:#9ECBFF\"> tasks</span><span style=\"color:#9ECBFF\"> move</span><span style=\"color:#9ECBFF\"> &quot;</span><span style=\"color:#E1E4E8\">$TICKET</span><span style=\"color:#9ECBFF\">&quot;</span><span style=\"color:#79B8FF\"> --section</span><span style=\"color:#9ECBFF\"> &quot;Review&quot;</span></span>",
